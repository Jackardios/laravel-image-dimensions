{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection.log",
        "summary": "build/infection-summary.log"
    },
    "mutators": {
        "@default": true,
        // An equivalent mutant: removing the (float) cast in
        // SvgDimensionsExtractor::parseLength() changes nothing, because the
        // regex only lets a plain numeric string through and PHP multiplies it
        // the same.
        "CastFloat": {
            "ignoreSourceCodeByRegex": [
                ".*\\$pixels = \\(float\\) \\$m\\['number'\\].*"
            ]
        },
        // Splitting a viewBox into at most six parts instead of five rejects
        // the same values: anything past the fourth is an error either way.
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                ".*preg_split\\('/\\[\\\\s,\\]\\+/', \\$value, 5,.*"
            ]
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100
}
